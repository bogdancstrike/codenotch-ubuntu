# Build output. The released .deb is tracked so the README's install command
# works straight from a clone.
/dist/*
!/dist/*.deb
/build/
docs/*.png
!docs/preview.png
!docs/preview-widgets.png
!docs/preview-edges.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Node (only used by the optional preview harness)
node_modules/
package-lock.json

# Editors and desktop cruft
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local scratch
/tmp/
*.log
